note omega-mcp tools: compile, run, explain_error, lookup. argcheck validates tools/call arguments
note before any reply bytes are written; prep does the work (sandboxed stages for compile and run);
note build writes the result object that becomes structuredContent and the text content.

text a_source "source"
text a_stdin "stdin"
text a_tmo "timeout_ms"
text a_query "query"
text e_aunk "Invalid params: unknown argument; see the tool's inputSchema in tools/list"
text e_asrc "Invalid params: arguments.source must be a string"
text e_abig "Invalid params: arguments.source is over 524288 bytes"
text e_astdin "Invalid params: arguments.stdin must be a string of at most 524288 bytes"
text e_atmo "Invalid params: arguments.timeout_ms must be an integer 1..30000"
text e_aq "Invalid params: arguments.query must be a string of 1..200 bytes or a nonnegative integer"
text e_aql "Invalid params: arguments.query must be a string of 1..64 bytes"

note ---- argument validation ----
note argkey: one member k of arguments for tool w; 0 or a message index for argerr
fn argkey ib view uchar 1572864 tape view uint 65536 k ulong w ulong to ulong
v = add k 1
o = js_off tape k
y = js_type tape v
if js_streq ib o a_source
if gt w 2
ret 1
end
if ne y jsstr
ret 2
end
put gv gsrct v
ret 0
end
if js_streq ib o a_stdin
if ne w 2
ret 1
end
if ne y jsstr
ret 4
end
put gv gstdt v
ret 0
end
if js_streq ib o a_tmo
ret argtmo ib tape v w
end
if js_streq ib o a_query
if lt w 3
ret 1
end
if eq y jsstr
put gv gqt v
ret 0
end
if and eq w 3 eq y jsnum
if js_isu ib js_off tape v
put gv gqt v
ret 0
end
end
if eq w 3
ret 6
end
ret 7
end
ret 1
end

fn argtmo ib view uchar 1572864 tape view uint 65536 v ulong w ulong to ulong
if ne w 2
ret 1
end
if ne js_type tape v jsnum
ret 5
end
o = js_off tape v
if not js_isu ib o
ret 5
end
t = js_tou ib o
if or lt t 1 gt t maxtmo
ret 5
end
put gv gtmo mul t 1000000
ret 0
end

note argsize: decoded sizes (ob is scratch: nothing has been written to it yet)
fn argsize ib view uchar 1572864 tape view uint 65536 ob edit uchar 787472 w ulong to ulong
if le w 2
n = js_sget ib js_off tape get gv gsrct ob
if or lt n 0 gt ulong n maxsrc
ret 3
end
s = get gv gstdt
if ne s jsnone
m = js_sget ib js_off tape s ob
if or lt m 0 gt ulong m 524288
ret 4
end
end
ret 0
end
q = get gv gqt
if ne js_type tape q jsstr
ret 0
end
k = js_sget ib js_off tape q ob
if eq w 4
if or lt k 1 gt k 64
ret 7
end
end
if or lt k 1 gt k 200
ret 6
end
ret 0
end

fn argcheck ib view uchar 1572864 tape view uint 65536 ob edit uchar 787472 w ulong to ulong
a = get gv garg
put gv gsrct jsnone
put gv gstdt jsnone
put gv gqt jsnone
put gv gtmo mul deftmo 1000000
if ne a jsnone
k = js_first tape a
while ne k jsnone bound 999999
e = argkey ib tape k w
if ne e 0
ret e
end
k = js_mnext tape k
end
end
if and le w 2 eq get gv gsrct jsnone
ret 2
end
if and eq w 3 eq get gv gqt jsnone
ret 6
end
if and eq w 4 eq get gv gqt jsnone
ret 7
end
ret argsize ib tape ob w
end

fn argerr ob edit uchar 787472 ib view uchar 1572864 tape view uint 65536 e ulong to void
if eq e 1
rerr ob ib tape jrpar e_aunk
end
if eq e 2
rerr ob ib tape jrpar e_asrc
end
if eq e 3
rerr ob ib tape jrpar e_abig
end
if eq e 4
rerr ob ib tape jrpar e_astdin
end
if eq e 5
rerr ob ib tape jrpar e_atmo
end
if eq e 6
rerr ob ib tape jrpar e_aq
end
if eq e 7
rerr ob ib tape jrpar e_aql
end
end

note ---- staging: compile and run in the sandbox ----
text l_cer " compile="
text l_res " run="
text l_stop " stop="
text l_ms " ms="
text l_rmf " TEMPDIR-NOT-REMOVED"

fn wfile t view uchar * a view uchar * to bool
f = tnew t 384
if lt f 0
ret false
end
ok = wfull int f a len a
c = fclose int f
ret and ok eq c 0
end

note cbat: whether cb[p..) starts with key
fn cbat p ulong key view uchar * to bool
for j ulong len key
if ne get cb add p j get key j
ret false
end
end
ret true
end

note cbnum: the decimal number after the first key in cb[off..off+n), or jsnone
fn cbnum off ulong n ulong key view uchar * to ulong
m = len key
if lt n m
ret jsnone
end
for i ulong add sub n m 1
if cbat add off i key
ret cbdig add add off i m sub sub n i m
end
end
ret jsnone
end

fn cbdig p ulong n ulong to ulong
v = ulong 0
k = ulong 0
for i ulong n
c = get cb add p i
if or lt c 48 gt c 57
break
end
if lt k 9
v = add mul v 10 ulong sub c 48
end
k = add k 1
end
if eq k 0
ret jsnone
end
ret v
end

text c_line "line "
text c_error "error "

note cinterp: gcer 0 compiled, 1 refused with a diagnostic (gqk code, gqln line), 2 stopped (gstop why)
fn cinterp to void
put gv gcer 2
s = get gv gsbf
if ne s 0
put gv gstop s
ret
end
t = get gv gtag
st = get gv gst
if eq get gv gwall 1
if or ne get gv gnoiso 0 eq t 0
put gv gstop 5
ret
end
end
if eq t 88
sig = and st 127
code = and shr st 8 255
if and eq sig 0 eq code 0
put gv gcer 0
ret
end
if eq sig 0
o = cbcer
n = get gv gcerc
k = cbnum o n c_error
l = cbnum o n c_line
if and eq k code ne l jsnone
put gv gcer 1
put gv gqk k
put gv gqln l
ret
end
put gv gstop 9
put gv gqc code
ret
end
put gv gstop 7
put gv gqc sig
ret
end
if eq t 69
put gv gstop 8
put gv gqc st
ret
end
put gv gstop 6
end

note rinterp: gres 1 exit (gqc), 2 trap (gqc), 3 cpu soft limit, 4 SIGKILL, 5 file size, 6 wall clock,
note 7 other signal (gqc), 8 exec failed (gqc errno), 9 sandbox failure (gstop why)
fn rinterp to void
put gv gres 9
s = get gv gsbf
if ne s 0
put gv gstop s
ret
end
t = get gv gtag
st = get gv gst
if eq get gv gwall 1
if or ne get gv gnoiso 0 eq t 0
put gv gres 6
ret
end
end
if eq t 88
sig = and st 127
code = and shr st 8 255
if eq sig 0
put gv gres 1
put gv gqc code
if and ge code 101 le code 114
put gv gres 2
put gv gqc sub code 100
end
ret
end
put gv gqc sig
put gv gres 7
if eq sig 24
put gv gres 3
end
if eq sig 25
put gv gres 5
end
if eq sig 9
put gv gres 4
end
ret
end
if eq t 69
put gv gres 8
put gv gqc st
ret
end
put gv gstop 6
end

fn shabin to void
f = trd f_bin
if lt f 0
put gv gcer 2
put gv gstop 10
ret
end
ok = sha_fd int f
c = fclose int f
if not ok
put gv gcer 2
put gv gstop 10
end
end

fn compile1 to void
spawn 0 cmpwall
z = capname f_cerr cbcer cbcern gcerc
put gv gcern z
cinterp
if eq get gv gcer 0
shabin
end
lg_t l_cer
lg_n get gv gcer
lg_t l_ms
lg_n get gv gelms
end

fn run1 to void
spawn 1 get gv gtmo
z = capname f_out cbout cboutn goutc
put gv goutn z
y = capname f_err cberr cberrn gerrc
put gv gerrn y
rinterp
lg_t l_res
lg_n get gv gres
lg_b 47
lg_n get gv gqc
lg_t l_ms
lg_n get gv gelms
end

fn stage ib view uchar 1572864 tape view uint 65536 ob edit uchar 787472 to void
put gv gcer 2
put gv gres 9
put gv gstop 0
put gv gqc 0
put gv gbinn 0
for s ulong 6
put gv add goutn s 0
end
if not mktemp
put gv gstop 1
ret
end
n = js_sget ib js_off tape get gv gsrct ob
ok = wfile f_src part ob 0 ulong n
m = ulong 0
d = get gv gstdt
if ne d jsnone
m = ulong js_sget ib js_off tape d ob
end
ok = and ok wfile f_in part ob 0 m
if not ok
put gv gstop 1
end
if ok
compile1
if and eq get gv gtool 2 eq get gv gcer 0
run1
end
end
if ne get gv gstop 0
lg_t l_stop
lg_n get gv gstop
end
if not rmtemp
lg_t l_rmf
end
end

note ---- result builders ----
text j_ok "ok"
text j_bb "binary_bytes"
text j_sha "sha256"
text j_line "line"
text j_mean "meaning"
text j_fix "fix"
text j_cstd "compiler_stderr"
text j_stop "stopped"
text j_csha "compiler_sha256"
text j_comp "compile"
text j_exit "exit"
text j_out "stdout"
text j_outb "stdout_bytes"
text j_outt "stdout_truncated"
text j_err "stderr"
text j_errb "stderr_bytes"
text j_errt "stderr_truncated"
