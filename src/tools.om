text j_trap "trap"
text j_exc "exit_code"
text j_limit "limit"
text j_sig "signal"
text j_errno "errno"
text j_cpu "cpu_seconds"
text j_as "address_space_bytes"
text j_fsz "file_size_bytes"
text j_npr "processes"
text j_note "note"
text j_match "match"
