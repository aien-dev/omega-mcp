note omega-mcp: start-up. Resolves this executable, the pinned compiler and the data directory,
note checks the compiler's sha256 against the pin and the presence of /usr/bin/bwrap and /usr/bin/prlimit.

text kself "/proc/self/exe"
text k_omc "--omc"
text k_dat "--data"
text k_noiso "--test-only-no-isolation"
text kdomc "/omc"
text kddat "/data/"

note argeq: argument i equals t
fn argeq i ulong t view uchar * to bool
r = argread i pa 0 4096
if ne r long len t
ret false
end
for j ulong len t
if ne get pa j get t j
ret false
end
end
ret true
end

fn hexof v ulong to uchar
ret get khex v
end

note sha_fd: sha256 of everything readable from fd into bsha (globals cannot be arguments, so the
note digest is computed in locals and copied); gv gbinn gets the byte count; false on a read error
fn sha_fd fd int to bool
c = new uchar 104 0
b = new uchar 65536 0
o = new uchar 32 0
sha256_init c
t = ulong 0
for i ulong 999999
r = read fd b 0 65536
if lt r 0
ret false
end
if eq r 0
break
end
sha256_update c part b 0 ulong r
t = add t ulong r
end
sha256_final c o
for i ulong 32
put bsha i get o i
end
put gv gbinn t
ret true
end

note sha_file: sha256 of the compiler at omcp into bsha
fn sha_file to bool
f = fopen omcp 0 get gv gomcl ofrd 0
if lt f 0
ret false
end
ok = sha_fd int f
z = fclose int f
ret ok
end

note pinok: bsha equals the pinned digest
fn pinok to bool
for i ulong 32
b = get bsha i
if ne hexof ulong shr b 4 get kpin mul i 2
ret false
end
if ne hexof ulong and b 15 get kpin add mul i 2 1
ret false
end
end
ret true
end

note boot: returns 0 ready, 2 bad arguments, 3 compiler missing or not the pin, 5 sandbox tools missing
fn boot to int
put gv gnoiso 0
n = readlnk kself 0 len kself sx 0 4095
if le n 0
ret 2
end
put gv gsxl ulong n
d = ulong n
while gt d 0 bound 4096
if eq get sx sub d 1 47
break
end
d = sub d 1
end
for i ulong d
put omcp i get sx i
put datp i get sx i
end
for i ulong sub len kdomc 1
put omcp add d i get kdomc add i 1
end
put gv gomcl add d sub len kdomc 1
for i ulong sub len kddat 1
put datp add d i get kddat add i 1
end
put gv gdatl add d sub len kddat 1
a = ulong argcnt
i = ulong 1
while lt i a bound 64
if argeq i k_noiso
put gv gnoiso 1
i = add i 1
continue
end
if and argeq i k_omc lt add i 1 a
r = argread add i 1 omcp 0 4000
if le r 0
ret 2
end
if ne get omcp 0 47
ret 2
end
put gv gomcl ulong r
i = add i 2
continue
end
if and argeq i k_dat lt add i 1 a
r = argread add i 1 datp 0 3000
if le r 0
ret 2
end
put datp ulong r 47
put gv gdatl add ulong r 1
i = add i 2
continue
end
ret 2
end
if not sha_file
ret 3
end
if not pinok
ret 3
end
if eq get gv gnoiso 0
if ne faccess kbwrap 0 len kbwrap 1 0
ret 5
end
if ne faccess kprlim 0 len kprlim 1 0
ret 5
end
end
ret 0
end
